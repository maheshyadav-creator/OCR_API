from __future__ import annotations

import csv
import gc
import json
import os
import resource
import threading
import time
from concurrent.futures import (
    ThreadPoolExecutor,
    as_completed,
)
from datetime import datetime, timezone
from pathlib import Path
from typing import Any

import fitz
import numpy as np
import psutil
from pypdf import PdfReader

from app.services.ocr_service import (
    OCR_ENGINE_LOCK,
    get_ocr_engine,
)


# ============================================================
# CONFIGURATION
# ============================================================

PROJECT_ROOT = Path(
    "/home/mahesh/Documents/OCR_API"
)

PDF_DIR = PROJECT_ROOT / "test_pdf"

RESULTS_DIR = (
    PROJECT_ROOT / "benchmark_results"
)

BENCHMARK_LIMIT = int(
    os.getenv(
        "BENCHMARK_LIMIT",
        "10",
    )
)

# ------------------------------------------------------------
# CONCURRENCY
# ------------------------------------------------------------

CONCURRENCY = int(
    os.getenv(
        "BENCHMARK_CONCURRENCY",
        "2",
    )
)

# ------------------------------------------------------------
# RETRY CONFIGURATION
# ------------------------------------------------------------

MAX_RETRIES = int(
    os.getenv(
        "BENCHMARK_MAX_RETRIES",
        "3",
    )
)

RETRY_DELAY_SECONDS = float(
    os.getenv(
        "BENCHMARK_RETRY_DELAY",
        "2",
    )
)

# ------------------------------------------------------------
# PaddleOCR CPU configuration
# ------------------------------------------------------------

OCR_LANG = os.getenv(
    "OCR_LANG",
    "en",
)

OCR_DEVICE = os.getenv(
    "OCR_DEVICE",
    "cpu",
)

OCR_CPU_THREADS = int(
    os.getenv(
        "OCR_CPU_THREADS",
        "2",
    )
)

# ------------------------------------------------------------
# PDF rendering configuration
# ------------------------------------------------------------

PDF_DPI = int(
    os.getenv(
        "OCR_PDF_DPI",
        "200",
    )
)

# ------------------------------------------------------------
# Benchmark identity
# ------------------------------------------------------------

WORKER_ID = "single_worker"

WORKER_COUNT = 1

# ------------------------------------------------------------
# Output files
# ------------------------------------------------------------

CSV_PATH = (
    RESULTS_DIR / "per_document.csv"
)

SUMMARY_PATH = (
    RESULTS_DIR / "summary.json"
)

BENCHMARK_PATH = (
    RESULTS_DIR / "benchmark.json"
)


# ============================================================
# PROCESS INFORMATION
# ============================================================

def get_process() -> psutil.Process:
    """
    Return the current Python process.
    """

    return psutil.Process(
        os.getpid()
    )


def get_logical_cpu_count() -> int:
    """
    Return logical CPU count.
    """

    return (
        psutil.cpu_count(
            logical=True
        )
        or 1
    )


# ============================================================
# TIME HELPERS
# ============================================================

def utc_timestamp() -> str:
    """
    Return an ISO-8601 UTC timestamp.
    """

    return datetime.now(
        timezone.utc
    ).isoformat()


def mb(value: float) -> float:
    """
    Convert bytes to MB.
    """

    return value / (
        1024 * 1024
    )


# ============================================================
# FILE HELPERS
# ============================================================

def get_pdf_size(
    pdf_path: Path,
) -> int:
    """
    Return PDF size in bytes.
    """

    return pdf_path.stat().st_size


def get_pdf_page_count(
    pdf_path: Path,
) -> int:
    """
    Return PDF page count.

    This is intentionally performed
    outside OCR timing.
    """

    reader = PdfReader(
        str(pdf_path)
    )

    return len(
        reader.pages
    )


def discover_pdfs() -> list[Path]:
    """
    Discover benchmark PDFs.
    """

    if not PDF_DIR.exists():

        raise FileNotFoundError(
            f"PDF directory does not exist: "
            f"{PDF_DIR}"
        )

    pdfs = sorted(
        PDF_DIR.glob(
            "ocr_test_*.pdf"
        )
    )

    if not pdfs:

        raise FileNotFoundError(
            f"No benchmark PDFs found in: "
            f"{PDF_DIR}"
        )

    return pdfs[
        :BENCHMARK_LIMIT
    ]


# ============================================================
# SAFE VALUE CONVERSION
# ============================================================

def safe_float(
    value: Any,
) -> float | None:

    if value is None:
        return None

    try:

        return float(value)

    except (
        TypeError,
        ValueError,
    ):

        return None


# ============================================================
# PEAK RSS
# ============================================================

def resource_peak_rss_bytes() -> int:
    """
    Return lifetime maximum RSS
    for this Python process.

    Linux reports ru_maxrss in KB.
    """

    usage = resource.getrusage(
        resource.RUSAGE_SELF
    )

    return int(
        usage.ru_maxrss * 1024
    )


# ============================================================
# OCR RESULT EXTRACTION
# ============================================================

def extract_page_result(
    result: Any,
    page_number: int,
) -> tuple[
    dict[str, Any],
    str,
    list[float],
]:
    """
    Extract OCR text and confidence
    values from one PaddleOCR result.
    """

    result_data = result.json

    if not isinstance(
        result_data,
        dict,
    ):

        result_data = {}

    data = result_data.get(
        "res",
        result_data,
    )

    if not isinstance(
        data,
        dict,
    ):

        data = {}

    texts = data.get(
        "rec_texts",
        [],
    )

    scores = data.get(
        "rec_scores",
        [],
    )

    page_text_parts: list[
        str
    ] = []

    confidence_values: list[
        float
    ] = []

    for text, score in zip(
        texts,
        scores,
    ):

        text = str(
            text
        ).strip()

        if not text:
            continue

        try:

            confidence = float(
                score
            )

        except (
            TypeError,
            ValueError,
        ):

            continue

        page_text_parts.append(
            text
        )

        confidence_values.append(
            confidence
        )

    page_text = "\n".join(
        page_text_parts
    )

    page_data = {
        "page": page_number,
        "text": page_text,
        "raw": result_data,
    }

    return (
        page_data,
        page_text,
        confidence_values,
    )


# ============================================================
# OCR ONE NUMPY IMAGE
# ============================================================

def ocr_numpy_image(
    ocr: Any,
    image: np.ndarray,
    page_number: int,
) -> tuple[
    dict[str, Any],
    str,
    list[float],
]:
    """
    Run PaddleOCR on one rendered PDF page.

    The image is supplied as a NumPy array.

    IMPORTANT:
        The PaddleOCR engine is shared by all
        benchmark threads.

        OCR_ENGINE_LOCK ensures that only one
        thread calls ocr.predict() at a time.

    This prevents multiple PaddleOCR inference
    operations from simultaneously using the
    same engine on the constrained machine.
    """

    with OCR_ENGINE_LOCK:

        results = ocr.predict(
            image
        )

    for result in results:

        return extract_page_result(
            result,
            page_number,
        )

    return (
        {
            "page": page_number,
            "text": "",
            "raw": {},
        },
        "",
        [],
    )


# ============================================================
# PDF OCR
# ============================================================

def run_pdf_ocr(
    pdf_path: Path,
    ocr: Any,
) -> dict[str, Any]:
    """
    OCR a PDF one page at a time.

    Pipeline:

        PDF
          ↓
        PyMuPDF
          ↓
        Render one page
          ↓
        NumPy image
          ↓
        Shared PaddleOCR engine
          ↓
        OCR_ENGINE_LOCK
          ↓
        PaddleOCR inference
          ↓
        Release page memory
          ↓
        Next page

    The same PaddleOCR engine is reused
    for every page and every PDF in this
    benchmark process.
    """

    pages: list[
        dict[str, Any]
    ] = []

    all_text: list[str] = []

    confidence_values: list[
        float
    ] = []

    print(
        f"[{threading.current_thread().name}] "
        f"Opening PDF with PyMuPDF: "
        f"{pdf_path.name}"
    )

    document = fitz.open(
        str(pdf_path)
    )

    try:

        page_count = len(
            document
        )

        print(
            f"[{threading.current_thread().name}] "
            f"PDF opened: "
            f"{pdf_path.name} "
            f"({page_count} pages, "
            f"{PDF_DPI} DPI)"
        )

        # ----------------------------------------------------
        # Convert DPI to PDF zoom.
        #
        # PDF default resolution is 72 DPI.
        # ----------------------------------------------------

        zoom = (
            PDF_DPI / 72.0
        )

        matrix = fitz.Matrix(
            zoom,
            zoom,
        )

        # ----------------------------------------------------
        # Process one page at a time.
        # ----------------------------------------------------

        for page_index in range(
            page_count
        ):

            page_number = (
                page_index + 1
            )

            print(
                f"[{threading.current_thread().name}] "
                f"[PDF] Processing "
                f"{pdf_path.name} "
                f"page "
                f"{page_number}/"
                f"{page_count}"
            )

            page = None
            pixmap = None
            image_array = None

            try:

                # ------------------------------------------------
                # Load one page.
                # ------------------------------------------------

                page = document.load_page(
                    page_index
                )

                # ------------------------------------------------
                # Render page into RGB pixels.
                # ------------------------------------------------

                pixmap = page.get_pixmap(
                    matrix=matrix,
                    colorspace=fitz.csRGB,
                    alpha=False,
                )

                print(
                    f"[{threading.current_thread().name}] "
                    f"[PDF] Page "
                    f"{page_number}: "
                    f"{pixmap.width}x"
                    f"{pixmap.height}"
                )

                # ------------------------------------------------
                # Convert rendered pixels to NumPy.
                # ------------------------------------------------

                image_array = np.frombuffer(
                    pixmap.samples,
                    dtype=np.uint8,
                )

                image_array = (
                    image_array.reshape(
                        pixmap.height,
                        pixmap.width,
                        pixmap.n,
                    )
                )

                # ------------------------------------------------
                # Run OCR on this single page.
                # ------------------------------------------------

                (
                    page_data,
                    page_text,
                    page_confidences,
                ) = ocr_numpy_image(
                    ocr,
                    image_array,
                    page_number,
                )

                pages.append(
                    page_data
                )

                if page_text:

                    all_text.append(
                        page_text
                    )

                confidence_values.extend(
                    page_confidences
                )

                print(
                    f"[{threading.current_thread().name}] "
                    f"[PDF] Completed "
                    f"{pdf_path.name} "
                    f"page "
                    f"{page_number}/"
                    f"{page_count}"
                )

            finally:

                # ------------------------------------------------
                # Release page-level Python references.
                #
                # gc.collect() does NOT guarantee that Paddle/Paddle
                # native memory is returned to the OS, but it helps
                # release Python-side objects between pages.
                # ------------------------------------------------

                image_array = None
                pixmap = None
                page = None

                gc.collect()

    finally:

        document.close()

        gc.collect()

    # ========================================================
    # Final PDF result
    # ========================================================

    extracted_text = "\n\n".join(
        all_text
    )

    if confidence_values:

        average_confidence = (
            sum(
                confidence_values
            )
            / len(
                confidence_values
            )
        )

    else:

        average_confidence = 0.0

    return {
        "text": extracted_text,
        "pages": pages,
        "page_count": len(pages),
        "confidence": average_confidence,
        "file_name": pdf_path.name,
    }


# ============================================================
# OCR RESULT
# ============================================================

def run_ocr(
    pdf_path: Path,
) -> dict[str, Any]:
    """
    Run OCR using ONE shared PaddleOCR engine.

    The engine comes from the application's
    cached get_ocr_engine() function.

    Because all benchmark threads execute
    inside the same Python process, the cached
    engine is shared by all threads.

    PDFs are processed page-by-page using
    PyMuPDF + NumPy.
    """

    # --------------------------------------------------------
    # Get the shared cached PaddleOCR engine.
    #
    # get_ocr_engine() uses @lru_cache(maxsize=1)
    # in app.services.ocr_service.
    #
    # Therefore this Python process has one
    # PaddleOCR engine instance.
    # --------------------------------------------------------

    ocr = get_ocr_engine()

    thread_name = (
        threading.current_thread().name
    )

    print(
        f"[{thread_name}] "
        f"Running OCR: "
        f"{pdf_path.name}"
    )

    # --------------------------------------------------------
    # PDF
    # --------------------------------------------------------

    if pdf_path.suffix.lower() == ".pdf":

        return run_pdf_ocr(
            pdf_path,
            ocr,
        )

    # --------------------------------------------------------
    # Non-PDF fallback
    #
    # Benchmark currently uses PDFs, but this keeps the
    # function usable for an image file if needed later.
    # --------------------------------------------------------

    with OCR_ENGINE_LOCK:

        results = ocr.predict(
            str(pdf_path)
        )

    pages: list[
        dict[str, Any]
    ] = []

    all_text: list[str] = []

    confidence_values: list[
        float
    ] = []

    for page_number, result in enumerate(
        results,
        start=1,
    ):

        (
            page_data,
            page_text,
            page_confidences,
        ) = extract_page_result(
            result,
            page_number,
        )

        pages.append(
            page_data
        )

        if page_text:

            all_text.append(
                page_text
            )

        confidence_values.extend(
            page_confidences
        )

    extracted_text = "\n\n".join(
        all_text
    )

    if confidence_values:

        average_confidence = (
            sum(
                confidence_values
            )
            / len(
                confidence_values
            )
        )

    else:

        average_confidence = 0.0

    return {
        "text": extracted_text,
        "pages": pages,
        "page_count": len(pages),
        "confidence": average_confidence,
        "file_name": pdf_path.name,
    }


# ============================================================
# SINGLE DOCUMENT BENCHMARK
# ============================================================

def benchmark_document(
    pdf_path: Path,
    document_number: int,
) -> dict[str, Any]:
    """
    Process one PDF.

    The function is executed by one of the
    concurrent benchmark slots.

    IMPORTANT:
        The benchmark slots do NOT create their
        own PaddleOCR engines.

        All slots use the same shared engine.
    """

    process = get_process()

    thread = threading.current_thread()

    thread_name = thread.name

    # --------------------------------------------------------
    # File information
    # --------------------------------------------------------

    size_bytes = get_pdf_size(
        pdf_path
    )

    size_kb = (
        size_bytes / 1024
    )

    size_mb = mb(
        size_bytes
    )

    try:

        page_count = (
            get_pdf_page_count(
                pdf_path
            )
        )

    except Exception as exc:

        print(
            f"WARNING: Could not read "
            f"page count for "
            f"{pdf_path.name}: {exc}"
        )

        page_count = None

    print()
    print(
        "=" * 70
    )
    print(
        f"START DOCUMENT {document_number}"
    )
    print(
        f"File          : {pdf_path.name}"
    )
    print(
        f"Size          : {size_mb:.3f} MB"
    )
    print(
        f"Pages         : {page_count}"
    )
    print(
        f"Worker        : {WORKER_ID}"
    )
    print(
        f"Thread        : {thread_name}"
    )
    print(
        "=" * 70
    )

    # --------------------------------------------------------
    # Retry loop
    # --------------------------------------------------------

    final_status = "failed"

    final_error = ""

    successful_attempt = None

    total_attempts = 0

    final_result: dict[
        str,
        Any,
    ] = {}

    first_start_timestamp = None

    final_end_timestamp = None

    total_wall_time = 0.0

    total_cpu_time = 0.0

    max_ram_after_mb = 0.0

    min_ram_before_mb = None

    max_peak_rss_mb = None

    final_cpu_cores_used = 0.0

    final_cpu_machine_capacity_percent = 0.0

    # --------------------------------------------------------
    # Attempt processing
    # --------------------------------------------------------

    for attempt in range(
        1,
        MAX_RETRIES + 1,
    ):

        total_attempts = attempt

        print()
        print(
            f"[{thread_name}] "
            f"{pdf_path.name} "
            f"attempt "
            f"{attempt}/{MAX_RETRIES}"
        )

        # ----------------------------------------------------
        # Memory before
        # ----------------------------------------------------

        ram_before_bytes = (
            process.memory_info().rss
        )

        ram_before_mb = mb(
            ram_before_bytes
        )

        if (
            min_ram_before_mb
            is None
        ):

            min_ram_before_mb = (
                ram_before_mb
            )

        # ----------------------------------------------------
        # CPU before
        # ----------------------------------------------------

        cpu_before = (
            process.cpu_times()
        )

        cpu_before_seconds = (
            cpu_before.user
            + cpu_before.system
        )

        # ----------------------------------------------------
        # Timing
        # ----------------------------------------------------

        start_timestamp = (
            utc_timestamp()
        )

        if first_start_timestamp is None:

            first_start_timestamp = (
                start_timestamp
            )

        wall_start = (
            time.perf_counter()
        )

        status = "success"

        error_message = ""

        result: dict[
            str,
            Any,
        ] = {}

        # ----------------------------------------------------
        # OCR
        # ----------------------------------------------------

        try:

            result = run_ocr(
                pdf_path
            )

        except Exception as exc:

            status = "failed"

            error_message = (
                f"{type(exc).__name__}: "
                f"{exc}"
            )

        # ----------------------------------------------------
        # Timing end
        # ----------------------------------------------------

        wall_end = (
            time.perf_counter()
        )

        end_timestamp = (
            utc_timestamp()
        )

        wall_time_seconds = (
            wall_end - wall_start
        )

        # ----------------------------------------------------
        # CPU after
        # ----------------------------------------------------

        cpu_after = (
            process.cpu_times()
        )

        cpu_after_seconds = (
            cpu_after.user
            + cpu_after.system
        )

        cpu_time_seconds = (
            cpu_after_seconds
            - cpu_before_seconds
        )

        # ----------------------------------------------------
        # CPU calculations
        # ----------------------------------------------------

        cpu_cores_used = (
            cpu_time_seconds
            / wall_time_seconds
            if wall_time_seconds > 0
            else 0.0
        )

        logical_cpu_count = (
            get_logical_cpu_count()
        )

        cpu_machine_capacity_percent = (
            cpu_cores_used
            / logical_cpu_count
            * 100
            if logical_cpu_count > 0
            else 0.0
        )

        # ----------------------------------------------------
        # RAM after
        # ----------------------------------------------------

        ram_after_bytes = (
            process.memory_info().rss
        )

        ram_after_mb = mb(
            ram_after_bytes
        )

        ram_delta_mb = (
            ram_after_mb
            - ram_before_mb
        )

        # ----------------------------------------------------
        # Peak RSS
        # ----------------------------------------------------

        peak_rss_mb = mb(
            resource_peak_rss_bytes()
        )

        # ----------------------------------------------------
        # Save metrics
        # ----------------------------------------------------

        total_wall_time += (
            wall_time_seconds
        )

        total_cpu_time += (
            cpu_time_seconds
        )

        max_ram_after_mb = max(
            max_ram_after_mb,
            ram_after_mb,
        )

        if (
            max_peak_rss_mb
            is None
        ):

            max_peak_rss_mb = (
                peak_rss_mb
            )

        else:

            max_peak_rss_mb = max(
                max_peak_rss_mb,
                peak_rss_mb,
            )

        # ----------------------------------------------------
        # Success
        # ----------------------------------------------------

        if status == "success":

            final_status = "success"

            successful_attempt = (
                attempt
            )

            final_result = result

            final_end_timestamp = (
                end_timestamp
            )

            final_cpu_cores_used = (
                cpu_cores_used
            )

            final_cpu_machine_capacity_percent = (
                cpu_machine_capacity_percent
            )

            print(
                f"[{thread_name}] "
                f"SUCCESS: "
                f"{pdf_path.name}"
            )

            print(
                f"Attempt          : "
                f"{attempt}"
            )

            print(
                f"Wall time        : "
                f"{wall_time_seconds:.3f}s"
            )

            print(
                f"CPU time         : "
                f"{cpu_time_seconds:.3f}s"
            )

            print(
                f"CPU cores used   : "
                f"{cpu_cores_used:.2f}"
            )

            print(
                f"CPU capacity     : "
                f"{cpu_machine_capacity_percent:.2f}%"
            )

            print(
                f"RAM before       : "
                f"{ram_before_mb:.2f} MB"
            )

            print(
                f"RAM after        : "
                f"{ram_after_mb:.2f} MB"
            )

            print(
                f"Peak RSS         : "
                f"{peak_rss_mb:.2f} MB"
            )

            break

        # ----------------------------------------------------
        # Failure
        # ----------------------------------------------------

        final_error = (
            error_message
        )

        print(
            f"[{thread_name}] "
            f"FAILED: "
            f"{pdf_path.name}"
        )

        print(
            f"Error: "
            f"{error_message}"
        )

        # ----------------------------------------------------
        # Retry
        # ----------------------------------------------------

        if attempt < MAX_RETRIES:

            retry_delay = (
                RETRY_DELAY_SECONDS
                * (2 ** (attempt - 1))
            )

            print(
                f"[{thread_name}] "
                f"Retrying in "
                f"{retry_delay:.1f}s..."
            )

            time.sleep(
                retry_delay
            )

        else:

            final_end_timestamp = (
                end_timestamp
            )

    # ========================================================
    # Final document metrics
    # ========================================================

    confidence = None

    text_characters = 0

    if (
        final_status == "success"
        and isinstance(
            final_result,
            dict,
        )
    ):

        confidence = safe_float(
            final_result.get(
                "confidence"
            )
        )

        extracted_text = (
            final_result.get(
                "text",
                "",
            )
        )

        if extracted_text is not None:

            text_characters = len(
                str(
                    extracted_text
                )
            )

    # --------------------------------------------------------
    # Average metrics across attempts
    # --------------------------------------------------------

    average_attempt_wall_time = (
        total_wall_time
        / total_attempts
        if total_attempts > 0
        else 0.0
    )

    average_attempt_cpu_time = (
        total_cpu_time
        / total_attempts
        if total_attempts > 0
        else 0.0
    )

    ram_delta_mb = (
        max_ram_after_mb
        - (
            min_ram_before_mb
            if min_ram_before_mb
            is not None
            else max_ram_after_mb
        )
    )

    # ========================================================
    # Final record
    # ========================================================

    return {
        "document_number": document_number,
        "filename": pdf_path.name,
        "file_path": str(pdf_path),
        "file_type": "application/pdf",

        "size_bytes": size_bytes,
        "size_kb": round(
            size_kb,
            3,
        ),
        "size_mb": round(
            size_mb,
            6,
        ),

        "page_count": page_count,

        "worker_id": WORKER_ID,
        "worker_count": WORKER_COUNT,

        "thread_name": thread_name,
        "thread_id": thread.ident,

        "concurrency_limit": CONCURRENCY,

        "pdf_dpi": PDF_DPI,

        "ocr_cpu_threads": OCR_CPU_THREADS,

        "attempts": total_attempts,
        "successful_attempt": (
            successful_attempt
        ),
        "retry_count": (
            max(
                total_attempts - 1,
                0,
            )
        ),

        "start_timestamp": (
            first_start_timestamp
        ),
        "end_timestamp": (
            final_end_timestamp
        ),

        "ocr_wall_time_seconds": round(
            total_wall_time,
            6,
        ),

        "average_attempt_wall_time_seconds": round(
            average_attempt_wall_time,
            6,
        ),

        "cpu_process_time_seconds": round(
            total_cpu_time,
            6,
        ),

        "average_attempt_cpu_time_seconds": round(
            average_attempt_cpu_time,
            6,
        ),

        "cpu_cores_used": round(
            final_cpu_cores_used,
            6,
        ),

        "cpu_machine_capacity_percent": round(
            final_cpu_machine_capacity_percent,
            6,
        ),

        "logical_cpu_count": (
            get_logical_cpu_count()
        ),

        "ram_before_mb": round(
            min_ram_before_mb
            if min_ram_before_mb
            is not None
            else 0.0,
            3,
        ),

        "ram_after_mb": round(
            max_ram_after_mb,
            3,
        ),

        "peak_rss_mb": round(
            max_peak_rss_mb
            if max_peak_rss_mb
            is not None
            else 0.0,
            3,
        ),

        "ram_delta_mb": round(
            ram_delta_mb,
            3,
        ),

        "confidence": (
            round(
                confidence,
                6,
            )
            if confidence is not None
            else None
        ),

        "text_characters": (
            text_characters
        ),

        "status": final_status,

        "error": final_error,
    }


# ============================================================
# CSV
# ============================================================

def write_csv(
    records: list[
        dict[str, Any]
    ],
) -> None:

    RESULTS_DIR.mkdir(
        parents=True,
        exist_ok=True,
    )

    if not records:
        return

    fieldnames = list(
        records[0].keys()
    )

    with CSV_PATH.open(
        "w",
        newline="",
        encoding="utf-8",
    ) as file:

        writer = csv.DictWriter(
            file,
            fieldnames=fieldnames,
        )

        writer.writeheader()

        for record in records:

            writer.writerow(
                record
            )


# ============================================================
# SUMMARY
# ============================================================

def calculate_summary(
    records: list[
        dict[str, Any]
    ],
    benchmark_wall_time_seconds: float,
    benchmark_start_timestamp: str,
    benchmark_end_timestamp: str,
) -> dict[str, Any]:

    successful = [
        record
        for record in records
        if record["status"]
        == "success"
    ]

    failed = [
        record
        for record in records
        if record["status"]
        != "success"
    ]

    # --------------------------------------------------------
    # Input
    # --------------------------------------------------------

    total_size_bytes = sum(
        int(
            record[
                "size_bytes"
            ]
        )
        for record in records
    )

    total_size_mb = mb(
        total_size_bytes
    )

    successful_size_bytes = sum(
        int(
            record[
                "size_bytes"
            ]
        )
        for record in successful
    )

    successful_size_mb = mb(
        successful_size_bytes
    )

    total_pages = sum(
        int(
            record[
                "page_count"
            ]
        )
        for record in records
        if record[
            "page_count"
        ] is not None
    )

    successful_pages = sum(
        int(
            record[
                "page_count"
            ]
        )
        for record in successful
        if record[
            "page_count"
        ] is not None
    )

    # --------------------------------------------------------
    # OCR timing
    # --------------------------------------------------------

    total_ocr_wall_time = sum(
        float(
            record[
                "ocr_wall_time_seconds"
            ]
        )
        for record in successful
    )

    total_cpu_time = sum(
        float(
            record[
                "cpu_process_time_seconds"
            ]
        )
        for record in successful
    )

    # --------------------------------------------------------
    # Counts
    # --------------------------------------------------------

    successful_count = len(
        successful
    )

    failed_count = len(
        failed
    )

    retry_count = sum(
        int(
            record[
                "retry_count"
            ]
        )
        for record in records
    )

    # --------------------------------------------------------
    # Averages
    # --------------------------------------------------------

    if successful_count:

        average_time_per_document = (
            total_ocr_wall_time
            / successful_count
        )

        average_time_per_page = (
            total_ocr_wall_time
            / successful_pages
            if successful_pages > 0
            else 0.0
        )

        average_cpu_time = (
            total_cpu_time
            / successful_count
        )

        average_cpu_usage = (
            sum(
                float(
                    record[
                        "cpu_machine_capacity_percent"
                    ]
                )
                for record in successful
            )
            / successful_count
        )

        average_ram_before = (
            sum(
                float(
                    record[
                        "ram_before_mb"
                    ]
                )
                for record in successful
            )
            / successful_count
        )

        average_ram_after = (
            sum(
                float(
                    record[
                        "ram_after_mb"
                    ]
                )
                for record in successful
            )
            / successful_count
        )

        average_peak_rss = (
            sum(
                float(
                    record[
                        "peak_rss_mb"
                    ]
                )
                for record in successful
            )
            / successful_count
        )

        average_confidence_values = [
            float(
                record[
                    "confidence"
                ]
            )
            for record in successful
            if record[
                "confidence"
            ] is not None
        ]

        average_confidence = (
            sum(
                average_confidence_values
            )
            / len(
                average_confidence_values
            )
            if average_confidence_values
            else None
        )

    else:

        average_time_per_document = 0.0
        average_time_per_page = 0.0
        average_cpu_time = 0.0
        average_cpu_usage = 0.0
        average_ram_before = 0.0
        average_ram_after = 0.0
        average_peak_rss = 0.0
        average_confidence = None

    # --------------------------------------------------------
    # Throughput
    # --------------------------------------------------------

    documents_per_second = (
        successful_count
        / benchmark_wall_time_seconds
        if benchmark_wall_time_seconds > 0
        else 0.0
    )

    pages_per_second = (
        successful_pages
        / benchmark_wall_time_seconds
        if benchmark_wall_time_seconds > 0
        else 0.0
    )

    mb_per_second = (
        successful_size_mb
        / benchmark_wall_time_seconds
        if benchmark_wall_time_seconds > 0
        else 0.0
    )

    gb_per_hour = (
        mb_per_second
        * 3600
        / 1024
    )

    # --------------------------------------------------------
    # Maximum RSS
    # --------------------------------------------------------

    peak_values = [
        float(
            record[
                "peak_rss_mb"
            ]
        )
        for record in records
        if record[
            "peak_rss_mb"
        ] is not None
    ]

    maximum_peak_rss_mb = (
        max(peak_values)
        if peak_values
        else None
    )

    # --------------------------------------------------------
    # Summary
    # --------------------------------------------------------

    return {
        "benchmark_type": (
            "single_process_concurrent_ocr"
        ),

        "worker_count": WORKER_COUNT,

        "worker_id": WORKER_ID,

        "concurrency": CONCURRENCY,

        "ocr_cpu_threads_per_slot": (
            OCR_CPU_THREADS
        ),

        "pdf_dpi": PDF_DPI,

        "max_retries": MAX_RETRIES,

        "retry_delay_seconds": (
            RETRY_DELAY_SECONDS
        ),

        "logical_cpu_count": (
            get_logical_cpu_count()
        ),

        "pdf_directory": str(
            PDF_DIR
        ),

        "results_directory": str(
            RESULTS_DIR
        ),

        "benchmark_start_timestamp": (
            benchmark_start_timestamp
        ),

        "benchmark_end_timestamp": (
            benchmark_end_timestamp
        ),

        "documents_requested": len(
            records
        ),

        "documents": len(
            records
        ),

        "successful": (
            successful_count
        ),

        "failed": (
            failed_count
        ),

        "success_rate_percent": (
            successful_count
            / len(records)
            * 100
            if records
            else 0.0
        ),

        "total_retries": (
            retry_count
        ),

        "total_input_size_mb": (
            total_size_mb
        ),

        "successful_size_mb": (
            successful_size_mb
        ),

        "total_pages": (
            total_pages
        ),

        "successful_pages": (
            successful_pages
        ),

        "total_ocr_wall_time_seconds": (
            total_ocr_wall_time
        ),

        "benchmark_wall_time_seconds": (
            benchmark_wall_time_seconds
        ),

        "average_time_per_document_seconds": (
            average_time_per_document
        ),

        "average_time_per_page_seconds": (
            average_time_per_page
        ),

        "documents_per_second": (
            documents_per_second
        ),

        "pages_per_second": (
            pages_per_second
        ),

        "mb_per_second": (
            mb_per_second
        ),

        "gb_per_hour": (
            gb_per_hour
        ),

        "total_cpu_time_seconds": (
            total_cpu_time
        ),

        "average_cpu_time_seconds": (
            average_cpu_time
        ),

        "average_cpu_machine_capacity_percent": (
            average_cpu_usage
        ),

        "average_ram_before_mb": (
            average_ram_before
        ),

        "average_ram_after_mb": (
            average_ram_after
        ),

        "average_peak_rss_mb": (
            average_peak_rss
        ),

        "maximum_peak_rss_mb": (
            maximum_peak_rss_mb
        ),

        "average_confidence": (
            average_confidence
        ),

        "measurement_notes": {
            "one_python_process": True,

            "concurrent_execution": True,

            "concurrency_slots": (
                CONCURRENCY
            ),

            "shared_paddleocr_engine": True,

            "paddleocr_engine_initialization": (
                "once_per_benchmark_process"
            ),

            "paddleocr_engine_source": (
                "app.services.ocr_service.get_ocr_engine"
            ),

            "ocr_inference_serialized_by_lock": (
                True
            ),

            "ocr_engine_lock_source": (
                "app.services.ocr_service.OCR_ENGINE_LOCK"
            ),

            "pdf_processing": (
                "Each PDF is opened with PyMuPDF "
                "and rendered one page at a time "
                "at the configured DPI before "
                "being passed to the shared PaddleOCR engine."
            ),

            "paddleocr_mkldnn": False,

            "redis_used": False,

            "postgres_used": False,

            "api_used": False,

            "cpu_time_definition": (
                "Process user + system CPU time "
                "measured during each OCR attempt. "
                "Because OCR slots run concurrently "
                "inside one process, this process-level "
                "CPU time can include activity from "
                "other concurrent slots."
            ),

            "cpu_cores_used_definition": (
                "CPU seconds divided by wall-clock "
                "seconds for an OCR attempt. "
                "This is a process-level measurement "
                "and is not an exclusive per-thread "
                "CPU measurement."
            ),

            "cpu_machine_capacity_definition": (
                "CPU cores used divided by logical "
                "CPU count multiplied by 100."
            ),

            "peak_rss_definition": (
                "Lifetime maximum RSS of the "
                "single benchmark process."
            ),

            "memory_cleanup_definition": (
                "Page-level PyMuPDF and NumPy "
                "references are released after "
                "each page and Python garbage "
                "collection is requested. "
                "Native Paddle/PaddleOCR allocators "
                "may retain memory."
            ),

            "retry_definition": (
                "Failed OCR attempts are retried "
                "with exponential backoff."
            ),

            "engine_sharing_definition": (
                "All benchmark concurrency slots "
                "run inside the same Python process "
                "and obtain the same cached PaddleOCR "
                "engine. OCR_ENGINE_LOCK serializes "
                "calls to the shared engine."
            ),
        },
    }


# ============================================================
# CONCURRENT BENCHMARK
# ============================================================

def run_concurrent_benchmark(
    pdfs: list[Path],
) -> list[
    dict[str, Any]
]:

    print()
    print(
        "=" * 70
    )

    print(
        "INITIALIZING SHARED PADDLEOCR ENGINE"
    )

    print(
        "=" * 70
    )

    print(
        "Engine ownership  : "
        "ONE shared engine"
    )

    print(
        "Initialization    : "
        "once per benchmark process"
    )

    print(
        "MKL-DNN           : "
        "False"
    )

    print(
        "CPU threads       : "
        f"{OCR_CPU_THREADS}"
    )

    print(
        "Device            : "
        f"{OCR_DEVICE}"
    )

    print(
        "=" * 70
    )

    # --------------------------------------------------------
    # IMPORTANT
    #
    # Initialize the engine BEFORE creating the worker
    # threads.
    #
    # This guarantees that the benchmark starts with exactly
    # one PaddleOCR engine in this Python process.
    # --------------------------------------------------------

    get_ocr_engine()

    print(
        "Shared PaddleOCR engine initialized."
    )

    print(
        "The same engine will be reused "
        "for all benchmark documents."
    )

    print(
        "=" * 70
    )

    print()
    print(
        "=" * 70
    )

    print(
        "STARTING CONCURRENT OCR"
    )

    print(
        f"Worker process     : {WORKER_ID}"
    )

    print(
        f"Worker count       : {WORKER_COUNT}"
    )

    print(
        f"Concurrency        : {CONCURRENCY}"
    )

    print(
        f"OCR CPU threads    : "
        f"{OCR_CPU_THREADS}"
    )

    print(
        f"PDF DPI            : "
        f"{PDF_DPI}"
    )

    print(
        f"Logical CPUs       : "
        f"{get_logical_cpu_count()}"
    )

    print(
        "PaddleOCR engines  : "
        "1 shared engine"
    )

    print(
        "OCR lock           : "
        "enabled"
    )

    print(
        "=" * 70
    )

    records: list[
        dict[str, Any]
    ] = []

    with ThreadPoolExecutor(
        max_workers=CONCURRENCY,
        thread_name_prefix="ocr-slot",
    ) as executor:

        future_to_document = {}

        # ----------------------------------------------------
        # Submit all documents
        # ----------------------------------------------------

        for document_number, pdf_path in enumerate(
            pdfs,
            start=1,
        ):

            future = executor.submit(
                benchmark_document,
                pdf_path,
                document_number,
            )

            future_to_document[
                future
            ] = document_number

        # ----------------------------------------------------
        # Collect completed documents
        # ----------------------------------------------------

        for future in as_completed(
            future_to_document
        ):

            document_number = (
                future_to_document[
                    future
                ]
            )

            try:

                record = future.result()

                records.append(
                    record
                )

            except Exception as exc:

                print()
                print(
                    f"DOCUMENT "
                    f"{document_number} "
                    f"CRASHED"
                )

                print(
                    f"{type(exc).__name__}: "
                    f"{exc}"
                )

    # --------------------------------------------------------
    # Restore document ordering
    # --------------------------------------------------------

    records.sort(
        key=lambda record:
        record[
            "document_number"
        ]
    )

    return records


# ============================================================
# MAIN
# ============================================================

def main() -> None:

    print()
    print(
        "=" * 70
    )

    print(
        "OCR SINGLE-WORKER "
        "2-CONCURRENT BENCHMARK"
    )

    print(
        "=" * 70
    )

    print(
        f"Project       : "
        f"{PROJECT_ROOT}"
    )

    print(
        f"PDF directory : "
        f"{PDF_DIR}"
    )

    print(
        f"Results       : "
        f"{RESULTS_DIR}"
    )

    print(
        f"Worker        : "
        f"{WORKER_ID}"
    )

    print(
        f"Workers       : "
        f"{WORKER_COUNT}"
    )

    print(
        f"Concurrency   : "
        f"{CONCURRENCY}"
    )

    print(
        f"Documents     : "
        f"{BENCHMARK_LIMIT}"
    )

    print(
        f"CPU threads   : "
        f"{OCR_CPU_THREADS}"
    )

    print(
        f"PDF DPI       : "
        f"{PDF_DPI}"
    )

    print(
        f"Max retries   : "
        f"{MAX_RETRIES}"
    )

    print(
        f"Retry delay   : "
        f"{RETRY_DELAY_SECONDS}s"
    )

    print(
        f"Logical CPUs  : "
        f"{get_logical_cpu_count()}"
    )

    print(
        "PaddleOCR      : "
        "1 shared engine"
    )

    print(
        "MKL-DNN        : "
        "False"
    )

    RESULTS_DIR.mkdir(
        parents=True,
        exist_ok=True,
    )

    # --------------------------------------------------------
    # Discover PDFs
    # --------------------------------------------------------

    pdfs = discover_pdfs()

    print()
    print(
        "Documents selected:"
    )

    for index, pdf_path in enumerate(
        pdfs,
        start=1,
    ):

        print(
            f"  {index:02d}. "
            f"{pdf_path.name}"
        )

    # --------------------------------------------------------
    # Benchmark timing
    # --------------------------------------------------------

    benchmark_start_timestamp = (
        utc_timestamp()
    )

    benchmark_start = (
        time.perf_counter()
    )

    # --------------------------------------------------------
    # Run concurrent OCR
    # --------------------------------------------------------

    records = (
        run_concurrent_benchmark(
            pdfs
        )
    )

    # --------------------------------------------------------
    # End timing
    # --------------------------------------------------------

    benchmark_end = (
        time.perf_counter()
    )

    benchmark_end_timestamp = (
        utc_timestamp()
    )

    benchmark_wall_time_seconds = (
        benchmark_end
        - benchmark_start
    )

    # --------------------------------------------------------
    # Write CSV
    # --------------------------------------------------------

    write_csv(
        records
    )

    # --------------------------------------------------------
    # Calculate summary
    # --------------------------------------------------------

    summary = calculate_summary(
        records=records,

        benchmark_wall_time_seconds=(
            benchmark_wall_time_seconds
        ),

        benchmark_start_timestamp=(
            benchmark_start_timestamp
        ),

        benchmark_end_timestamp=(
            benchmark_end_timestamp
        ),
    )

    # --------------------------------------------------------
    # Save summary JSON
    # --------------------------------------------------------

    with SUMMARY_PATH.open(
        "w",
        encoding="utf-8",
    ) as file:

        json.dump(
            summary,
            file,
            indent=2,
        )

    # --------------------------------------------------------
    # Save complete benchmark JSON
    # --------------------------------------------------------

    benchmark_data = {
        "summary": summary,
        "documents": records,
    }

    with BENCHMARK_PATH.open(
        "w",
        encoding="utf-8",
    ) as file:

        json.dump(
            benchmark_data,
            file,
            indent=2,
        )

    # ========================================================
    # FINAL SUMMARY
    # ========================================================

    print()
    print(
        "=" * 70
    )

    print(
        "BENCHMARK COMPLETE"
    )

    print(
        "=" * 70
    )

    print(
        f"Worker count       : "
        f"{summary['worker_count']}"
    )

    print(
        f"Concurrency        : "
        f"{summary['concurrency']}"
    )

    print(
        f"Documents          : "
        f"{summary['documents']}"
    )

    print(
        f"Successful         : "
        f"{summary['successful']}"
    )

    print(
        f"Failed             : "
        f"{summary['failed']}"
    )

    print(
        f"Total retries      : "
        f"{summary['total_retries']}"
    )

    print(
        f"Total input        : "
        f"{summary['total_input_size_mb']:.3f} MB"
    )

    print(
        f"Successful input   : "
        f"{summary['successful_size_mb']:.3f} MB"
    )

    print(
        f"Total pages        : "
        f"{summary['total_pages']}"
    )

    print(
        f"Successful pages   : "
        f"{summary['successful_pages']}"
    )

    print(
        f"Benchmark time     : "
        f"{summary['benchmark_wall_time_seconds']:.3f}s"
    )

    print(
        f"Total OCR time     : "
        f"{summary['total_ocr_wall_time_seconds']:.3f}s"
    )

    print(
        f"Average/doc        : "
        f"{summary['average_time_per_document_seconds']:.3f}s"
    )

    print(
        f"Average/page       : "
        f"{summary['average_time_per_page_seconds']:.3f}s"
    )

    print(
        f"Documents/sec      : "
        f"{summary['documents_per_second']:.6f}"
    )

    print(
        f"Pages/sec          : "
        f"{summary['pages_per_second']:.6f}"
    )

    print(
        f"MB/sec             : "
        f"{summary['mb_per_second']:.6f}"
    )

    print(
        f"GB/hour            : "
        f"{summary['gb_per_hour']:.6f}"
    )

    print(
        f"Total CPU time     : "
        f"{summary['total_cpu_time_seconds']:.3f}s"
    )

    print(
        f"Average CPU usage  : "
        f"{summary['average_cpu_machine_capacity_percent']:.2f}%"
    )

    print(
        f"Average RAM        : "
        f"{summary['average_ram_after_mb']:.2f} MB"
    )

    print(
        f"Average Peak RSS   : "
        f"{summary['average_peak_rss_mb']:.2f} MB"
    )

    if (
        summary[
            "maximum_peak_rss_mb"
        ]
        is not None
    ):

        print(
            f"Maximum Peak RSS   : "
            f"{summary['maximum_peak_rss_mb']:.2f} MB"
        )

    if (
        summary[
            "average_confidence"
        ]
        is not None
    ):

        print(
            f"Average confidence : "
            f"{summary['average_confidence']:.4f}"
        )

    print()

    print(
        "PaddleOCR engine   : "
        "1 shared engine"
    )

    print(
        "Engine initialized : "
        "once"
    )

    print(
        "OCR inference lock : "
        "enabled"
    )

    print()

    print(
        "Output files:"
    )

    print(
        f"  {CSV_PATH}"
    )

    print(
        f"  {SUMMARY_PATH}"
    )

    print(
        f"  {BENCHMARK_PATH}"
    )

    print()


if __name__ == "__main__":
    main()

