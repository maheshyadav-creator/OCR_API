APP_NAME=OCR API
APP_VERSION=1.0.0
DEBUG=false

# ============================================================
# POSTGRESQL
# ============================================================

DB_HOST=localhost
DB_PORT=5432
DB_NAME=ocr_db
DB_USER=ocr_user
